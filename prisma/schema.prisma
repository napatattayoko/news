// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model News {
  id          String   @id
  headline    String
  body        String
  publishedAt DateTime
  category    String   @default("markets")
  impact      String   @default("low")
  sentiment   String   @default("neutral")
  countryCode String   @default("global")
  regionTag   String   @default("global")
  tickers     String   // Storing JSON string of tickers array
  sources     String   // Storing JSON string of sources array
  createdAt   DateTime @default(now())
}

