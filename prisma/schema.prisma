generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model News {
  id          String   @id
  headline    String
  body        String
  publishedAt DateTime
  category    String   @default("markets")
  impact      String   @default("low")
  sentiment   String   @default("neutral")
  countryCode String   @default("global")
  regionTag   String   @default("global")
  tickers     String
  sources     String
  createdAt   DateTime @default(now())
}

model StockOutlook {
  symbol    String   @id
  outlook   String
  newsHash  String
  updatedAt DateTime @updatedAt
}

